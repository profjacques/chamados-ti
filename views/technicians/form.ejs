<%- include('../partials/header') %>

<header class="page-header">
  <div>
    <a href="/technicians" class="back-link"><%- icon('back', 16) %> Técnicos</a>
    <h1><%= isEdit ? 'Editar técnico' : 'Novo técnico' %></h1>
  </div>
</header>

<%- include('../partials/errors') %>

<form method="POST" action="<%= isEdit ? '/technicians/' + tecnico.id + '?_method=PUT' : '/technicians' %>" class="card form-narrow" id="tech-form" novalidate>
  <div class="field">
    <label for="nome">Nome completo <span class="req">*</span></label>
    <input type="text" id="nome" name="nome" value="<%= tecnico.nome || '' %>" required autofocus>
  </div>
  <div class="field">
    <label for="email">E-mail <span class="req">*</span></label>
    <input type="email" id="email" name="email" value="<%= tecnico.email || '' %>" required>
  </div>
  <div class="field">
    <label for="especialidade">Especialidade</label>
    <input type="text" id="especialidade" name="especialidade" value="<%= tecnico.especialidade || '' %>" placeholder="Ex.: Redes, Suporte N1, Sistemas…">
  </div>
  <label class="switch" for="ativo">
    <input type="checkbox" id="ativo" name="ativo" <%= tecnico.ativo ? 'checked' : '' %>>
    <span class="switch-track"><span class="switch-thumb"></span></span>
    <span>Técnico ativo <small class="muted">(pode receber chamados)</small></span>
  </label>
  <div class="form-actions row">
    <a href="/technicians" class="btn btn-ghost" id="tech-cancel">Cancelar</a>
    <button type="submit" class="btn btn-primary" id="tech-submit"><%- icon('check') %> Salvar</button>
  </div>
</form>

<%- include('../partials/footer') %>
